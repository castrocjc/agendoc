# Local development from the same computer:
VITE_API_BASE_URL=http://localhost:8081

# Local network testing from computer, phone or tablet:
# Replace the example IP with the current local IP of the development computer.
# VITE_API_BASE_URL=http://192.168.1.100:8081

# Development environment:
# VITE_API_BASE_URL=https://api-dev.example.com

# Production environment:
# VITE_API_BASE_URL=https://api.example.com